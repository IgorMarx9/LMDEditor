<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="assets\LAGGY.ico" Condition="Exists('assets\LAGGY.ico')" />
		<EmbeddedResource Include="assets\SERGIO.ico" Condition="Exists('assets\SERGIO.ico')" />
		<EmbeddedResource Include="assets\VAL.ico" Condition="Exists('assets\VAL.ico')" />
	</ItemGroup>

</Project>